# Install as a dedicated site only after checking existing virtual hosts and DNS.
# Use your existing TLS manager (for example Certbot) to add HTTPS afterwards.
server {
    listen 80;
    server_name gospeedraceway.com www.gospeedraceway.com;

    location / {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
